<Window x:Class="miniDSClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniDS" Height="600" Width="900" MinWidth="600" MinHeight="400"
        Background="#36393f">

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="#3a3d44"/>
            <Setter Property="Foreground" Value="#b9bbbe"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5865f2"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChannelListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <EventSetter Event="MouseEnter" Handler="ChannelItem_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="ChannelItem_MouseLeave"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#34373d"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3a3d44"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MessageInput" TargetType="TextBox">
            <Setter Property="Background" Value="#40444b"/>
            <Setter Property="Foreground" Value="#dcddde"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0,0,1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                  VerticalAlignment="Center"
                                  VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Background" Value="#5865f2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4752c4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MessageListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="MessageItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="#dcddde"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#32353b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Foreground" Value="#3ba55d"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="3" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1a3d25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Foreground" Value="#ed4245"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="3" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3d1a1a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#36393f">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="145*"/>
            <ColumnDefinition Width="72*"/>
            <ColumnDefinition Width="463*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Grid Grid.Column="0" Background="#2f3136">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#26282c" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="#202225">
                    <TextBlock Text="MiniDS" FontSize="15" FontWeight="Bold" Foreground="White"/>
                </Border>

                <Button DockPanel.Dock="Top" x:Name="CreateChannelButton"
                        Content="+ Создать канал"
                        Style="{StaticResource SidebarButton}"
                        Click="CreateChannelButton_Click"/>

                <TextBlock DockPanel.Dock="Top" Text="КАНАЛЫ"
                           Foreground="#72767d" FontSize="11" FontWeight="Bold"
                           Margin="12,8,8,4"/>

                <!-- Профиль пользователя внизу -->
                <Border DockPanel.Dock="Bottom" Background="#232428" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="#202225">
                    <StackPanel Orientation="Horizontal">
                        <!-- Аватарка-заглушка -->
                        <Border Width="32" Height="32" CornerRadius="16" Background="#5865f2" Margin="0,0,8,0">
                            <TextBlock x:Name="AvatarLetter" Text="?" Foreground="White" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="Bold" FontSize="14"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentUsername" Text="Пользователь" 
                       Foreground="White" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="В сети" Foreground="#3ba55d" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox x:Name="ChannelsList"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="ChannelsList_SelectionChanged"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource ChannelListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2" Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="# " Foreground="#72767d"
                                           VerticalAlignment="Center" Grid.Column="0"
                                           FontSize="14" Margin="4,0,2,0"/>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#b9bbbe"
                                           VerticalAlignment="Center"
                                           Grid.Column="1"
                                           FontSize="13"/>
                                <Button Content="➕"
                                        Click="AddUserButton_Click"
                                        Grid.Column="2"
                                        FontSize="8"
                                        
                                        Style="{StaticResource AddButton}"
                                        ToolTip="Добавить пользователя"/>
                                <Button Content="❌"
                                        Click="DeleteChannelButton_Click"
                                        Grid.Column="3"
                                        FontSize="7"
                                        Style="{StaticResource DeleteButton}"
                                        ToolTip="Удалить канал"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <!-- Правая панель -->
        <Grid Grid.Column="1" Background="#36393f" Grid.ColumnSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок канала -->
            <Border Grid.Row="0" Background="#2f3136" BorderThickness="0,0,0,1" BorderBrush="#202225" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Название канала слева -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                        <TextBlock Text="# " Foreground="#72767d" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ChannelTitle" Text="Выберите канал" Foreground="White" FontSize="15" FontWeight="Bold" Margin="2,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="|" Foreground="#40444b" FontSize="16" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MembersCount" Text="" Foreground="#72767d" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Кнопка звонка справа -->
                    <Button Grid.Column="1" Content="📞" 
                x:Name="VoiceButton"
                Click="VoiceButton_Click"
                Margin="0,0,0,0"
                ToolTip="Голосовой чат">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#72767d"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="20"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#34373d"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <ListBox x:Name="MessagesList"
             Grid.Row="1"
             Style="{StaticResource MessageListBox}"
             ItemContainerStyle="{StaticResource MessageItem}"/>

            <Border Grid.Row="2" Padding="12,8" Background="#36393f">
                <DockPanel>
                    <Button x:Name="SendButton"
                    DockPanel.Dock="Right"
                    Height="40"
                    Width="48"
                    VerticalAlignment="Center"
                    Style="{StaticResource SendButton}"
                    Click="SendButton_Click"
                    Content="&gt;"
                    Margin="8,0,0,0"/>
                    <TextBox x:Name="MessageInput"
                     Height="40"
                     VerticalAlignment="Center"
                     Style="{StaticResource MessageInput}"
                     KeyDown="MessageInput_KeyDown"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>